# ==============================================================================
# BetHacker Configuration File (.env)
# ==============================================================================

# LLM Provider: 'gemini', 'openai', 'openrouter', or 'deepseek'
LLM_PROVIDER=gemini

# Model name:
# - Gemini: gemini-2.5-flash, gemini-2.5-pro
# - OpenAI: gpt-4o, gpt-4o-mini
# - DeepSeek: deepseek-chat, deepseek-reasoner
# - OpenRouter: anthropic/claude-3.7-sonnet, deepseek/deepseek-r1
LLM_MODEL=gemini-2.5-flash

# API Keys (Điền key tương ứng với nhà cung cấp bạn chọn)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Security & Execution Settings
# require_approval: true (Hỏi người dùng [Y/n] trước khi chạy lệnh), false (Tự động chạy)
REQUIRE_APPROVAL=true

# Command execution timeout (seconds)
COMMAND_TIMEOUT_SECONDS=60

# Thư mục lưu trữ kết quả và log scan (tương đối hoặc tuyệt đối)
WORKSPACE_DIR=./workspace
