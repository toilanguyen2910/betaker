# ==============================================================================
# BetAker Configuration File (.env)
# ==============================================================================

# LLM Provider: 'deepseek', 'gemini', 'openai', or 'openrouter'
LLM_PROVIDER=deepseek

# Model name:
# - DeepSeek: deepseek-chat, deepseek-reasoner
# - Gemini: gemini-2.5-flash, gemini-2.5-pro
# - OpenAI: gpt-4o, gpt-4o-mini
# - OpenRouter: anthropic/claude-3.7-sonnet, deepseek/deepseek-r1
LLM_MODEL=deepseek-chat

# API Keys (Provide the key corresponding to your chosen provider)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Security & Execution Settings
# REQUIRE_APPROVAL: true (Prompt user [Y/n] before executing terminal commands), false (Automatic)
REQUIRE_APPROVAL=true

# Command execution timeout (seconds)
COMMAND_TIMEOUT_SECONDS=60

# Directory for scan reports and workspace files (relative or absolute)
WORKSPACE_DIR=./workspace
